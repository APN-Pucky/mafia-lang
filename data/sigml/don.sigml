<sigml>
  <hns_sign gloss="don">
    <hamnosys_nonmanual/>
    <hamnosys_manual>
      <hamsymmlr/>

      <!-- Handshape per hand: one hand pinches (holds the ring), the
           other is the flat/open hand wearing it -->
      <hamparbegin/>
        <hampinch12open/>
        <hamfingerstraightmod/>
        <hamextfingerol/>
        <hampalmd/>
        <hamplus/>
        <hamfinger2345/>
        <hamthumboutmod/>
        <hamextfingeror/>
        <hampalmd/>
      <hamparend/>

      <!-- Location per hand -->
      <hamparbegin/>
        <hamshoulders/>
        <hamlrat/>
        <hamplus/>
        <hamchest/>
      <hamparend/>

      <!-- Movement per hand -->
      <hamparbegin/>
        <hammoveil/>
        <hamplus/>
        <hamnomotion/>
      <hamparend/>

      <!-- Contact: index fingertip touches the base of the ring finger -->
      <hamparbegin/>
        <hamfingerbase/>
        <hamringfinger/>
        <hamplus/>
        <hamfingertip/>
        <hamindexfinger/>
      <hamparend/>
      <hamtouch/>
    </hamnosys_manual>
  </hns_sign>
</sigml>
