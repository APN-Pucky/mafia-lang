<sigml>
  <hns_sign gloss="don">
    <hamnosys_nonmanual></hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfinger2345/>
      <hamthumbacrossmod/>
      <hamextfingeru/>
      <hampalmd/>
      <hamneutralspace/>

      <!-- Finger movement rather than whole-hand movement: thumb taps
           the base of the ring finger, repeatedly -->
      <hamparbegin/>
        <hamfingerbase/>
        <hamringfinger/>
        <hamplus/>
        <hamfingertip/>
        <hamthumb/>
      <hamparend/>
      <hamtouch/>
      <hamrepeatcontinueseveral/>

    </hamnosys_manual>
  </hns_sign>
</sigml>
