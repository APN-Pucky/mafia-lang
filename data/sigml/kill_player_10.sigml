<sigml>
  <hns_sign gloss="kill_player_10">
    <hamnosys_nonmanual/>
    <hamnosys_manual>

      <!-- Initial pose: 5 + 5 -->
      <hamparbegin/>
        <hamfinger2345/>
        <hamthumboutmod/>
        <hamextfingeru/>
        <hampalmd/>

        <hamplus/>

        <hamfinger2345/>
        <hamthumboutmod/>
        <hamextfingeru/>
        <hampalmd/>
      <hamparend/>

      <!-- Hook: only the primary 5-finger hand curls -->
      <hamreplace/>
      <hamfinger2345/>
      <hamfingerhookmod/>

      <hamrepeatfromstart/>

    </hamnosys_manual>
  </hns_sign>
</sigml>
