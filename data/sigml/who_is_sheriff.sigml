<sigml>
  <hns_sign gloss="who_is_sheriff">
    <hamnosys_nonmanual/>
    <hamnosys_manual>

      <hamparbegin/>

        <!-- First hand: sheriff -->
        <hampinch12open/>
        <hamfingerstraightmod/>
        <hamextfingeru/>
        <hampalml/>

        <hamplus/>

        <!-- Second hand: question mark -->
        <hamfinger2/>
        <hamfingerhookmod/>
        <hamextfingeru/>
        <hampalmr/>

      <hamparend/>

    </hamnosys_manual>
  </hns_sign>
</sigml>