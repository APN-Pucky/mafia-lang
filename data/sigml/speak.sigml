<sigml>
  <hns_sign gloss="speak">
    <hamnosys_nonmanual/>
    <hamnosys_manual>
      <!-- Fingers and thumb form a talking hand -->
      <hampinchall/>
      <hamextfingerul/>
      <hampalmd/>
  <hamshouldertop/>
      <hammouth/>

   <!-- Open the hand -->
      <hamreplace/>
      <hamflathand/>
      <hamthumbopenmod/>
      <hamextfingerul/>
      <hampalmd/>

      <!-- Repeat opening and closing -->
      <hamrepeatfromstart/>
   
    </hamnosys_manual>
  </hns_sign>
</sigml>